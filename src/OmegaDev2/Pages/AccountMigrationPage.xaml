<Page
    x:Class="OmegaDev2.Pages.AccountMigrationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OmegaDev2.Pages"
    Background="{ThemeResource OmegaDev2.PageBackgroundBrush}"
    NavigationCacheMode="Enabled">

    <ScrollViewer>
        <Grid Padding="24,20,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,14">
                <TextBlock Text="Account Migration"
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource OmegaDev2.TextPrimaryBrush}" />
                <TextBlock Text="Move an account between servers running different client versions (1.48 / 1.52 / 1.53) — same login, same characters. Clone Login below copies your actual account row (email/player name/password) so the exact same login works on the target version. Then log in there once and use Export/Import to bring over avatars, team-ups, and items. Anything that doesn't exist on the target version (e.g. BUE-era gear on a 1.48 import) is skipped and reported, never silently dropped."
                           FontSize="13"
                           TextWrapping="Wrap"
                           MaxWidth="900"
                           Foreground="{ThemeResource OmegaDev2.TextSecondaryBrush}" />
            </StackPanel>

            <!-- Server Control -->
            <Border Grid.Row="1"
                    Background="{ThemeResource OmegaDev2.PanelBackgroundBrush}"
                    CornerRadius="6"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel Spacing="10">
                    <TextBlock Text="SERVER CONTROL" FontSize="11" FontWeight="SemiBold" CharacterSpacing="160" Foreground="{ThemeResource OmegaDev2.AccentBrush}" />
                    <TextBlock Text="All three servers can run and be logged into at the same time — each version's client routes to its own server automatically, no switching needed." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource OmegaDev2.TextSecondaryBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="MHServerEmu folder:" VerticalAlignment="Center" FontSize="12" />
                        <TextBox x:Name="RepoPathBox" Width="300" TextChanged="PathBox_TextChanged" />
                        <Button Content="Browse…" Click="BrowseRepoDir_Click" />
                    </StackPanel>

                    <TextBlock Text="Client exe paths (set once, saved automatically — only needed to use Launch Client below):" FontSize="12" Foreground="{ThemeResource OmegaDev2.TextSecondaryBrush}" />

                    <Grid ColumnSpacing="10" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="1.48" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="ClientPath48Box" Width="380" TextChanged="PathBox_TextChanged" />
                        <Button Grid.Row="0" Grid.Column="2" Content="Browse…" Tag="v48" Click="BrowseClientExe_Click" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="1.52" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="ClientPath52Box" Width="380" TextChanged="PathBox_TextChanged" />
                        <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Tag="v52" Click="BrowseClientExe_Click" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="1.53" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="ClientPath53Box" Width="380" TextChanged="PathBox_TextChanged" />
                        <Button Grid.Row="2" Grid.Column="2" Content="Browse…" Tag="v53" Click="BrowseClientExe_Click" />
                    </Grid>

                    <Grid ColumnSpacing="10" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="1.48" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <Button Grid.Row="0" Grid.Column="1" Content="Start Server" Tag="v48" Click="StartServer_Click" />
                        <Button Grid.Row="0" Grid.Column="2" Content="Launch Client" Tag="v48" Click="LaunchClient_Click" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="1.52" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <Button Grid.Row="1" Grid.Column="1" Content="Start Server" Tag="v52" Click="StartServer_Click" />
                        <Button Grid.Row="1" Grid.Column="2" Content="Launch Client" Tag="v52" Click="LaunchClient_Click" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="1.53" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <Button Grid.Row="2" Grid.Column="1" Content="Start Server" Tag="v53" Click="StartServer_Click" />
                        <Button Grid.Row="2" Grid.Column="2" Content="Launch Client" Tag="v53" Click="LaunchClient_Click" />
                    </Grid>

                    <TextBlock x:Name="ServerControlStatusText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource OmegaDev2.TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Export -->
            <Border Grid.Row="2"
                    Background="{ThemeResource OmegaDev2.PanelBackgroundBrush}"
                    CornerRadius="6"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel Spacing="10">
                    <TextBlock Text="1. EXPORT" FontSize="11" FontWeight="SemiBold" CharacterSpacing="160" Foreground="{ThemeResource OmegaDev2.AccentBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ComboBox x:Name="ExportServerCombo" Width="160" SelectedIndex="1" />
                        <TextBox x:Name="ExportPlayerBox" Width="220" PlaceholderText="player (* = first online)" Text="*" />
                        <Button x:Name="ExportBtn" Content="Export" Click="Export_Click" Style="{ThemeResource AccentButtonStyle}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="SaveSnapshotBtn" Content="Save Snapshot to File…" Click="SaveSnapshot_Click" IsEnabled="False" />
                        <TextBlock x:Name="ExportStatusText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource OmegaDev2.TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Import -->
            <Border Grid.Row="3"
                    Background="{ThemeResource OmegaDev2.PanelBackgroundBrush}"
                    CornerRadius="6"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel Spacing="10">
                    <TextBlock Text="2. IMPORT" FontSize="11" FontWeight="SemiBold" CharacterSpacing="160" Foreground="{ThemeResource OmegaDev2.AccentBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="LoadSnapshotBtn" Content="Load Snapshot from File…" Click="LoadSnapshot_Click" />
                        <TextBlock x:Name="LoadedSnapshotText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource OmegaDev2.TextSecondaryBrush}" Text="No snapshot loaded — export one above first, or load a previously saved file." />
                    </StackPanel>

                    <TextBlock Text="target version — used for both account creation below and the import itself" FontSize="12" Foreground="{ThemeResource OmegaDev2.TextSecondaryBrush}" />
                    <ComboBox x:Name="ImportServerCombo" Width="160" HorizontalAlignment="Left" SelectedIndex="0" />

                    <!-- Clone login — copies the account ROW itself (email, player name, password hash+salt) straight from the source server's Account.db into the target's. Pure DB work, no client/login needed for this step, and no password is ever retyped: the exact same email + password you already use on the source version logs in on the target version immediately after this. -->
                    <Border Background="{ThemeResource OmegaDev2.PageBackgroundBrush}" CornerRadius="4" Padding="12" Margin="0,4,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Account doesn't exist on the target server yet? Clone your login from the source server below — same email, same password, nothing retyped. (No-op if that email already exists on the target.)" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource OmegaDev2.TextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Source:" VerticalAlignment="Center" FontSize="12" />
                                <ComboBox x:Name="CloneSourceServerCombo" Width="110" SelectedIndex="1" />
                                <TextBox x:Name="CloneEmailBox" Width="220" PlaceholderText="account email (on source server)" />
                                <Button x:Name="CloneLoginBtn" Content="Clone Login to Target" Click="CloneLogin_Click" />
                            </StackPanel>
                            <TextBlock x:Name="CloneLoginStatusText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource OmegaDev2.TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox x:Name="ImportPlayerBox" Width="220" PlaceholderText="player (* = first online)" Text="*" />
                        <Button x:Name="ImportBtn" Content="Import" Click="Import_Click" Style="{ThemeResource AccentButtonStyle}" IsEnabled="False" />
                    </StackPanel>

                    <TextBlock x:Name="ImportStatusText" TextWrapping="Wrap" Foreground="{ThemeResource OmegaDev2.TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Skipped items -->
            <Border Grid.Row="4"
                    Background="{ThemeResource OmegaDev2.PanelBackgroundBrush}"
                    CornerRadius="6"
                    Padding="16"
                    Visibility="Collapsed"
                    x:Name="SkippedPanel">
                <StackPanel Spacing="8">
                    <TextBlock Text="SKIPPED (not available on the target version)" FontSize="11" FontWeight="SemiBold" CharacterSpacing="160" Foreground="{ThemeResource OmegaDev2.AccentBrush}" />
                    <ListView x:Name="SkippedList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" FontSize="12" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
