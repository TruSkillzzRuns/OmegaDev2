<Page
    x:Class="OmegaDev2.Pages.BountyBoardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OmegaDev2.Pages"
    xmlns:controls="using:OmegaDev2.Controls"
    Background="{ThemeResource OmegaDev2.PageBackgroundBrush}"
    NavigationCacheMode="Enabled">

    <Grid Padding="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,0,14" HorizontalAlignment="Left">
                <TextBlock Text="Bounty Board"
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource OmegaDev2.AccentGoldBrush}" />
                <TextBlock Text="Pick a nemesis from your history, set a tier (1-10), and post the bounty. You'll warp to a random arena — they'll find you 30-60s after you arrive. Higher tier means a harder fight and a bigger payout; tier 9-10 guarantees a best-in-slot drop."
                           FontSize="13"
                           TextWrapping="Wrap"
                           MaxWidth="920"
                           Foreground="{ThemeResource OmegaDev2.TextSecondaryBrush}" />
            </StackPanel>

            <controls:ServerVersionPicker Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" />
        </Grid>

        <!-- Toolbar -->
        <Border Grid.Row="1"
                Background="{ThemeResource OmegaDev2.PanelBackgroundBrush}"
                CornerRadius="6"
                Padding="14,10"
                Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="RefreshBtn" Content="Refresh Board" Click="Refresh_Click" />
                <TextBox x:Name="SearchBox"
                         Width="220"
                         PlaceholderText="search nemesis..."
                         TextChanged="SearchBox_TextChanged"
                         VerticalAlignment="Center" />
                <TextBox x:Name="PlayerBox"
                         Width="220"
                         PlaceholderText="player (* = first online)"
                         Text="*"
                         VerticalAlignment="Center" />
                <ToggleSwitch x:Name="ShowDefeatedSwitch"
                              OnContent="Show defeated"
                              OffContent="Active only"
                              VerticalAlignment="Center"
                              Toggled="ShowDefeatedSwitch_Toggled" />
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource OmegaDev2.TextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Board -->
        <Grid Grid.Row="2">
            <Border Background="{ThemeResource OmegaDev2.PanelBackgroundBrush}"
                    CornerRadius="6"
                    Padding="6">
                <GridView x:Name="BountyGrid"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          Padding="10">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="0" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:BountyCard">
                            <Border Width="272"
                                    Margin="6"
                                    Padding="14"
                                    CornerRadius="8"
                                    Background="{ThemeResource OmegaDev2.PageBackgroundBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource OmegaDev2.AccentGoldBrush}">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0"
                                                  Glyph="&#xE7EE;"
                                                  FontSize="18"
                                                  HorizontalAlignment="Left"
                                                  Foreground="{ThemeResource OmegaDev2.AccentGoldBrush}" />
                                        <Border Grid.Column="1"
                                                Background="{ThemeResource OmegaDev2.DangerBrush}"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                Visibility="{x:Bind DefeatedVisibility}">
                                            <TextBlock Text="DEFEATED" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{x:Bind Title}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource OmegaDev2.TextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Detail}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.7"
                                                   Foreground="{ThemeResource OmegaDev2.TextSecondaryBrush}" />
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Bind TierLabel, Mode=OneWay}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource OmegaDev2.AccentGoldBrush}" />
                                        <NumberBox Grid.Column="1"
                                                   Value="{x:Bind Tier, Mode=TwoWay}"
                                                   ValueChanged="TierNumberBox_ValueChanged"
                                                   Minimum="1"
                                                   Maximum="10"
                                                   SmallChange="1"
                                                   SpinButtonPlacementMode="Compact"
                                                   IsEnabled="{x:Bind CanBountyHunt}"
                                                   Width="90"
                                                   FontSize="12" />
                                    </Grid>

                                    <Button Content="Post Bounty"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="{x:Bind CanBountyHunt}"
                                            Background="{ThemeResource OmegaDev2.AccentGoldBrush}"
                                            Foreground="Black"
                                            FontWeight="SemiBold"
                                            Click="PostBounty_Click"
                                            ToolTipService.ToolTip="Warp to a random arena — this nemesis ambushes you there 30-60s after you arrive, at the tier selected" />

                                    <TextBlock Text="{x:Bind CardStatus, Mode=OneWay}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Opacity="0.75"
                                               Foreground="{ThemeResource OmegaDev2.TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Border>
        </Grid>
    </Grid>
</Page>
