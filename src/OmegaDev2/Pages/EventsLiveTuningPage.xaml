<Page
    x:Class="OmegaDev2.Pages.EventsLiveTuningPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OmegaDev2.Pages"
    xmlns:controls="using:OmegaDev2.Controls"
    Background="{ThemeResource OmegaDev2.PageBackgroundBrush}"
    NavigationCacheMode="Required">

    <Grid Padding="24,20,24,16" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <StackPanel Grid.Column="0" Spacing="4" HorizontalAlignment="Left">
                <TextBlock Text="Live Events"
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource OmegaDev2.TextPrimaryBrush}" />
                <TextBlock FontSize="13"
                           TextWrapping="Wrap"
                           MaxWidth="900"
                           Foreground="{ThemeResource OmegaDev2.TextSecondaryBrush}"
                           Text="MHO's own real live-tuning events (loot/XP multiplier holidays like OdinsBounty, WinterHoliday) — normally calendar-driven. Force one on right now for testing, or clear the override to restore the normal schedule." />
            </StackPanel>

            <controls:ServerVersionPicker Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" />
        </Grid>

        <!-- Toolbar -->
        <Border Grid.Row="1"
                Background="{ThemeResource OmegaDev2.PanelBackgroundBrush}"
                CornerRadius="6"
                Padding="14,10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="RefreshBtn" Content="Refresh" Click="Refresh_Click" />
                <Button x:Name="ClearBtn" Content="Clear Override (restore normal schedule)" Click="Clear_Click" />
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource OmegaDev2.TextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Known events list -->
        <Border Grid.Row="2"
                Background="{ThemeResource OmegaDev2.PanelBackgroundBrush}"
                CornerRadius="6"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="12,0,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="EVENT" FontSize="11" FontWeight="SemiBold" CharacterSpacing="160"
                               Foreground="{ThemeResource OmegaDev2.AccentBrush}" />
                    <TextBlock Grid.Column="1" Text="STATUS" FontSize="11" FontWeight="SemiBold" CharacterSpacing="160"
                               Foreground="{ThemeResource OmegaDev2.AccentBrush}" />
                    <TextBlock Grid.Column="2" Text="ACTION" FontSize="11" FontWeight="SemiBold" CharacterSpacing="160"
                               Foreground="{ThemeResource OmegaDev2.AccentBrush}" />
                </Grid>
                <ListView x:Name="EventList" Grid.Row="1" SelectionMode="None" Padding="0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:LiveTuningEventRow">
                            <Border BorderBrush="{ThemeResource OmegaDev2.PageBackgroundBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontSize="13" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="{x:Bind StatusDotBrush}" />
                                        <TextBlock Text="{x:Bind StatusLabel}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{x:Bind StatusTextBrush}" />
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Content="{x:Bind ToggleButtonLabel}"
                                            FontSize="11"
                                            MinWidth="84"
                                            HorizontalAlignment="Left"
                                            Background="{x:Bind ToggleButtonBrush}"
                                            Click="RowToggle_Click" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Warning -->
        <Border Grid.Row="3"
                Background="{ThemeResource OmegaDev2.PanelBackgroundBrush}"
                CornerRadius="6"
                Padding="12,8">
            <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                       Foreground="{ThemeResource OmegaDev2.TextSecondaryBrush}"
                       Text="Force Activate is a full live-tuning reload for the whole server — every player's game instance re-reads settings. Not scoped to just you; don't spam it." />
        </Border>
    </Grid>
</Page>
