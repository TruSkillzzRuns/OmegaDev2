<Page
    x:Class="OmegaDev2.Pages.TrialLeaderboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OmegaDev2.Pages"
    Background="{ThemeResource OmegaDev2.PageBackgroundBrush}"
    NavigationCacheMode="Enabled">

    <Grid Padding="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,14">
            <TextBlock Text="Trial of the Impossible — Leaderboard"
                       FontSize="32"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource OmegaDev2.TextPrimaryBrush}" />
            <TextBlock Text="Every account's Trial attempts, ranked together — completed runs first, fastest clear wins. Per-run stats (kills/deaths for that one attempt), not lifetime totals."
                       FontSize="13"
                       TextWrapping="Wrap"
                       MaxWidth="960"
                       Foreground="{ThemeResource OmegaDev2.TextSecondaryBrush}" />
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1"
                Background="{ThemeResource OmegaDev2.PanelBackgroundBrush}"
                CornerRadius="6"
                Padding="14,10"
                Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBox x:Name="SearchBox" Width="280" PlaceholderText="Search players, heroes, ranks..." TextChanged="SearchBox_TextChanged" />
                <Button Content="Refresh" Click="Refresh_Click" />
                <Rectangle Width="1" Fill="{ThemeResource OmegaDev2.TextSecondaryBrush}" Opacity="0.25" Margin="4,4" />
                <Button Content="Reset Leaderboard"
                        Click="ResetAll_Click"
                        ToolTipService.ToolTip="Deletes every account's Trial of the Impossible runs." />
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource OmegaDev2.TextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- List -->
        <Border Grid.Row="2"
                Background="{ThemeResource OmegaDev2.PanelBackgroundBrush}"
                CornerRadius="6"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="8,0,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" MinWidth="170" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="RANK" FontSize="11" FontWeight="SemiBold" CharacterSpacing="20" Foreground="{ThemeResource OmegaDev2.AccentBrush}" />
                    <TextBlock Grid.Column="1" Text="PLAYER" FontSize="11" FontWeight="SemiBold" CharacterSpacing="20" Foreground="{ThemeResource OmegaDev2.AccentBrush}" />
                    <TextBlock Grid.Column="2" Text="HERO" FontSize="11" FontWeight="SemiBold" CharacterSpacing="20" Foreground="{ThemeResource OmegaDev2.AccentBrush}" />
                    <TextBlock Grid.Column="3" Text="NEMESIS KILLS" FontSize="11" FontWeight="SemiBold" CharacterSpacing="20" Foreground="{ThemeResource OmegaDev2.AccentBrush}" TextWrapping="NoWrap" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="DEATHS" FontSize="11" FontWeight="SemiBold" CharacterSpacing="20" Foreground="{ThemeResource OmegaDev2.AccentBrush}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="RESULT" FontSize="11" FontWeight="SemiBold" CharacterSpacing="20" Foreground="{ThemeResource OmegaDev2.AccentBrush}" />
                    <TextBlock Grid.Column="6" Text="TIME" FontSize="11" FontWeight="SemiBold" CharacterSpacing="20" Foreground="{ThemeResource OmegaDev2.AccentBrush}" />
                    <TextBlock Grid.Column="7" Text="DATE" FontSize="11" FontWeight="SemiBold" CharacterSpacing="20" Foreground="{ThemeResource OmegaDev2.AccentBrush}" />
                    <TextBlock Grid.Column="8" Text="" FontSize="11" />
                </Grid>

                <ListView x:Name="EntryList" Grid.Row="1" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:TrialLeaderboardRow">
                            <Border Margin="0,3" Padding="8,10" CornerRadius="6" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" MinWidth="170" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind RankMedal}" FontSize="16" Visibility="{x:Bind MedalVisibility}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind RankText}" FontSize="14" FontWeight="SemiBold" Foreground="{x:Bind RankBrush}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{x:Bind PlayerName}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Border Width="32" Height="32" CornerRadius="16" MinWidth="32"
                                                Background="{ThemeResource OmegaDev2.PageBackgroundBrush}">
                                            <Image Source="{x:Bind Portrait, Mode=OneWay}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock Text="{x:Bind HeroName}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" Text="{x:Bind NemesisKillsText}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind DeathsText}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind ResultText}" FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind ResultBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind TimeText}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="7" Text="{x:Bind DateText}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
                                    <Button Grid.Column="8"
                                            Content="✕"
                                            FontSize="10"
                                            Padding="6,2"
                                            HorizontalAlignment="Right"
                                            Tag="{x:Bind}"
                                            Click="DeleteEntry_Click"
                                            ToolTipService.ToolTip="Delete this entry" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
