<UserControl
    x:Class="OmegaDev2.Controls.ServerVersionPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ServerVersionPicker — drop-in version switcher for the top of any
         page. Reads/writes the shared AppState.ServerUrl, so every page's
         existing "_api.BaseUrl = AppState.ServerUrl" pattern automatically
         talks to whichever version is selected here — no per-page wiring
         needed beyond dropping this control in. -->
    <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Server:" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
        <ComboBox x:Name="VersionCombo" Width="110" SelectionChanged="VersionCombo_SelectionChanged" />
    </StackPanel>
</UserControl>
